{
  "version": 1,
  "classes": ["nixos", "homeManager", "darwin"],
  "categories": {
    "alpha":  { "dir": "host-config/alpha",   "members": ["hw"],     "nested": [],      "flag": null },
    "beta":   { "dir": "host-config/beta",    "members": ["fw"],     "nested": [],      "flag": null },
    "base":   { "dir": "shared/base",         "members": ["locale", "turn-on"], "nested": ["net"], "flag": null },
    "net":    { "dir": "shared/base/net",     "members": ["ssh"],    "nested": [],      "flag": null },
    "extras": { "dir": "shared/extras",       "members": ["games"],  "nested": [],      "flag": null },
    "lonely": { "dir": "shared/lonely",       "members": ["unused"], "nested": [],      "flag": null },
    "me":     { "dir": "users/me",            "members": ["shell"],  "nested": [],      "flag": null }
  },
  "folders": [],
  "modules": {
    "hw":       { "path": "host-config/alpha/hw.nix",       "classes": ["nixos"] },
    "fw":       { "path": "host-config/beta/fw.nix",        "classes": ["nixos"] },
    "locale":   { "path": "shared/base/locale.nix",         "classes": ["nixos"] },
