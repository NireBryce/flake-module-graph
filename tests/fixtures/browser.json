    "unused":   { "path": "shared/lonely/unused.nix",       "classes": ["nixos"] },
    "shell":    { "path": "users/me/shell.nix",             "classes": ["homeManager"] },
    "alpha-host": { "path": "hosts/alpha-host.nix",         "classes": ["nixos"] },
    "beta-host":  { "path": "hosts/beta-host.nix",          "classes": ["nixos"] },
    "home":       { "path": "hosts/home.nix",               "classes": ["homeManager"] }
