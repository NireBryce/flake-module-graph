digraph modules {
    rankdir=LR; bgcolor="white"; nodesep=0.22; ranksep=0.9; splines=true; newrank=true; compound=true;
    node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11 fontcolor="#1e293b" penwidth=1.3 margin="0.16,0.08"];
    edge [color="#94a3b8" fontname="Helvetica" fontsize=9 fontcolor="#64748b" arrowsize=0.7];
    subgraph cluster_0 {
        label=<<font color="#64748b" point-size="10">hosts-config</font>>;
        style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.2; margin=14;
        n5 [label=<<b>laptop/</b><br/><font point-size="9" color="#64748b">n · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        n18 [label=<<b>hardware</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
    }
    subgraph cluster_1 {
        label=<<font color="#64748b" point-size="10">shared</font>>;
        style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.2; margin=14;
        n7 [label=<<b>desktop/</b><br/><font point-size="9" color="#64748b">n h · 3</font>> fillcolor="#dbeafe" color="#2563eb"];
        n8 [label=<<b>extras/</b><br/><font point-size="9" color="#64748b">n · 2</font>> fillcolor="#dbeafe" color="#2563eb" style="rounded,filled,dashed"];
        n9 [label=<<b>fonts/</b><br/><font point-size="9" color="#64748b">n · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        n10 [label=<<b>lonely/</b><br/><font point-size="9" color="#64748b">n · 1</font>> fillcolor="#fff1f2" color="#e11d48" penwidth=2.5];
        n11 [label=<<b>printing/</b><br/><font point-size="9" color="#64748b">n · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        n22 [label=<<b>apps/</b><br/><font point-size="9" color="#64748b">h · 2</font>> fillcolor="#f1f5f9" color="#94a3b8" shape=folder style=filled];
        n23 [label=<<b>wm</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n24 [label=<<b>editor</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n25 [label=<<b>other</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n26 [label=<<b>mono</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n27 [label=<<b>unused</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n28 [label=<<b>cups</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n31 [label=<<b>games/</b><br/><font point-size="9" color="#64748b">h · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        n32 [label=<<b>browser</b><br/><font point-size="9" color="#64748b">h</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n33 [label=<<b>chess</b><br/><font point-size="9" color="#64748b">h</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        subgraph cluster_2 {
            label=<<b>base/</b>  <font point-size="9" color="#64748b">n h d · 3</font>>;
            style="rounded,filled"; fillcolor="#eff6ff"; color="#2563eb"; penwidth=1.2; margin=14;
            n19 [label=<<b>net/</b><br/><font point-size="9" color="#64748b">n h · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
            n20 [label=<<b>locale</b><br/><font point-size="9" color="#64748b">n d</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
            n21 [label=<<b>turn-on</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
            n30 [label=<<b>ssh</b><br/><font point-size="9" color="#64748b">n h</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        }
    }
    subgraph cluster_3 {
        label=<<font color="#64748b" point-size="10">users</font>>;
        style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.2; margin=14;
        n12 [label=<<b>shell/</b><br/><font point-size="9" color="#64748b">h · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        n13 [label=<<b>me-home</b><br/><font point-size="9" color="#64748b">h</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n29 [label=<<b>zsh</b><br/><font point-size="9" color="#64748b">h</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
    }
    subgraph cluster_4 {
        label=<<font color="#64748b" point-size="10">hosts</font>>;
        style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.2; margin=14;
        n14 [label=<<b>laptop-host</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n15 [label=<<b>mac</b><br/><font point-size="9" color="#64748b">d</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        n16 [label=<<b>server</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
    }
    subgraph cluster_5 {
        label=<<font color="#64748b" point-size="10">(top level)</font>>;
        style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.2; margin=14;
        n17 [label=<<b>overlay</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
    }
    n5 -> n18;
    n7 -> n22;
    n7 -> n23;
    n8 -> n24;
    n8 -> n25;
    n9 -> n26;
    n10 -> n27;
    n11 -> n28;
    n12 -> n29;
    n19 -> n30;
    n22 -> n31 [style=dotted];
    n22 -> n32;
    n31 -> n33;
}
