digraph modules {
    rankdir=TB; bgcolor="white"; nodesep=0.22; ranksep=0.9; splines=true; newrank=true; compound=true;
    node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11 fontcolor="#1e293b" penwidth=1.3 margin="0.16,0.08"];
    edge [color="#94a3b8" fontname="Helvetica" fontsize=9 fontcolor="#64748b" arrowsize=0.7];
    subgraph cluster_0 {
        label=<<font color="#64748b" point-size="10">hosts-config</font>>;
        style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.2; margin=14;
        n0 [label=<<b>laptop/</b><br/><font point-size="9" color="#64748b">n · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
    }
    subgraph cluster_1 {
        label=<<font color="#64748b" point-size="10">shared</font>>;
        style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.2; margin=14;
        n5 [label=<<b>extras/</b><br/><font point-size="9" color="#64748b">n · 2</font>> fillcolor="#dbeafe" color="#2563eb" style="rounded,filled,dashed"];
        n6 [label=<<b>fonts/</b><br/><font point-size="9" color="#64748b">n · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        n7 [label=<<b>lonely/</b><br/><font point-size="9" color="#64748b">n · 1</font>> fillcolor="#fff1f2" color="#e11d48" penwidth=2.5];
        n8 [label=<<b>printing/</b><br/><font point-size="9" color="#64748b">n · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        n10 [label=<<b>editor</b><br/><font point-size="9" color="#64748b">n</font>> fillcolor="#ffffff" color="#94a3b8" shape=box style="rounded,filled"];
        subgraph cluster_2 {
            label=<<b>base/</b>  <font point-size="9" color="#64748b">n h d · 3</font>>;
            style="rounded,filled"; fillcolor="#eff6ff"; color="#2563eb"; penwidth=1.2; margin=14;
            n2 [label=<<b>net/</b><br/><font point-size="9" color="#64748b">n h · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        }
        subgraph cluster_3 {
            label=<<b>desktop/</b>  <font point-size="9" color="#64748b">n h · 3</font>>;
            style="rounded,filled"; fillcolor="#eff6ff"; color="#2563eb"; penwidth=1.2; margin=14;
            n4 [label=<<b>games/</b><br/><font point-size="9" color="#64748b">h · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
        }
    }
    subgraph cluster_4 {
        label=<<font color="#64748b" point-size="10">users</font>>;
        style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; penwidth=1.2; margin=14;
        n9 [label=<<b>shell/</b><br/><font point-size="9" color="#64748b">h · 1</font>> fillcolor="#dbeafe" color="#2563eb"];
    }
    subgraph cluster_5 {
        label=<<font color="#64748b" point-size="10">hosts and home</font>>;
        style="rounded,filled"; fillcolor="#fefce8"; color="#fde68a"; penwidth=1.2; margin=14;
        n16 [label=<<b>laptop-host</b><br/><font point-size="9" color="#64748b">nixos</font>> fillcolor="#ffffff" color="#16a34a" shape=box style="rounded,filled" penwidth=1.6];
        n18 [label=<<b>mac</b><br/><font point-size="9" color="#64748b">darwin</font>> fillcolor="#ffffff" color="#d97706" shape=box style="rounded,filled" penwidth=1.6];
        n19 [label=<<b>server</b><br/><font point-size="9" color="#64748b">nixos</font>> fillcolor="#ffffff" color="#9333ea" shape=box style="rounded,filled" penwidth=1.6];
        n20 [label=<<b>me-home</b><br/><font point-size="9" color="#64748b">homeManager</font>> fillcolor="#ffffff" color="#db2777" shape=box style="rounded,filled" penwidth=1.6];
    }
    n17 [label=<<b>ghost</b><br/><font point-size="9" color="#64748b">no such module</font>> fillcolor="#fee2e2" color="#ef4444"];
    n16 -> n2 [style=invis minlen=1];
    n16 -> n4 [style=invis minlen=1];
    n16 -> n5 [style=invis minlen=1];
    n16 -> n6 [style=invis minlen=1];
    n16 -> n7 [style=invis minlen=1];
    n16 -> n8 [style=invis minlen=2];
    { rank=same; n16 n18 n19 n20 }
    n5 -> n10;
    n0 -> n16 [dir=back color="#16a34a" penwidth=1.2];
    n16 -> n2 [color="#16a34a" penwidth=1.2 lhead=cluster_2];
    n16 -> n4 [color="#16a34a" penwidth=1.2 lhead=cluster_3];
    n16 -> n6 [color="#16a34a" penwidth=1.2];
    n16 -> n8 [color="#16a34a" penwidth=1.2];
    n16 -> n10 [color="#16a34a" penwidth=1.2];
    n16 -> n17 [color="#16a34a" penwidth=1.2];
    n18 -> n2 [color="#d97706" penwidth=1.2 lhead=cluster_2];
    n19 -> n2 [color="#9333ea" penwidth=1.2 lhead=cluster_2];
    n19 -> n8 [color="#9333ea" penwidth=1.2];
    n9 -> n20 [dir=back color="#db2777" penwidth=1.2];
    n20 -> n4 [color="#db2777" penwidth=1.2];
    n16 -> n20 [color="#16a34a" style=dashed penwidth=1.2 label="enables" fontcolor="#16a34a"];
    n19 -> n20 [color="#9333ea" style=dashed penwidth=1.2 label="enables" fontcolor="#9333ea"];
}
